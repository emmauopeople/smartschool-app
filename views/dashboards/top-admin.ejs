<!DOCTYPE html>
<html lang="en">
<head>
  <!-- 🧩 Navbar include -->
  <%- include('../partials/navbar.ejs') %>
  <title>Top Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    .sidebar {
      background-color: #f0f2f5;
      height: 100vh;
      padding: 1rem;
    }
    .dashboard-container {
      margin-top: 2rem;
    }
  </style>
</head>
<body>
        <!-- 🧑‍💼 Welcome Strip -->
    <div class="bg-light text-end px-3 py-2 border-bottom">
    <small>Welcome, <%= session.username %> | Role: <%= session.role %></small>
    </div>

  <div class="container-fluid">
    <div class="row">
      <!-- 🧭 Sidebar with panel links -->
       
      <div class="col-md-3 sidebar">
        <h4>Top Admin</h4>

        <!--modification start-->
        <ul class="nav flex-column">
        <li class="nav-item">
            <a href="/top-admin/users" class="nav-link <%= panel === 'users' ? 'fw-bold text-primary' : '' %>">👤 Manage Users</a>
        </li>
        <li class="nav-item">
            <a href="/top-admin/content" class="nav-link <%= panel === 'content' ? 'fw-bold text-primary' : '' %>">📄 Manage Content</a>
        </li>
        </ul>

        <!--modification end-->

        <ul class="nav flex-column">
          <li class="nav-item">
            <a href="/top-admin/users" class="nav-link">👤 Manage Users</a>
          </li>
          <li class="nav-item">
            <a href="/top-admin/content" class="nav-link">📄 Manage Content</a>
          </li>
          <!-- 🔜 Add more links for student, payments, etc. -->
        </ul>
      </div>

      <!-- 📦 Main Content Area -->
      <div class="col-md-9 dashboard-container">
        <!-- ⚠️ Feedback Messages -->
        <% if (message) { %>
        <div class="alert alert-info">
            <%= message %>
        </div>
        <% } %>

        <!-- ⚙️ Dynamic Panel Loader -->
        <% if (panel === 'users') { %>
          <%- include('../panels/manage-users-panel.ejs') %>
        <% } else if (panel === 'content') { %>
          <%- include('../panels/manage-content-panel.ejs') %>
        <% } else { %>
          <p>Select a panel from the menu.</p>
        <% } %>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
